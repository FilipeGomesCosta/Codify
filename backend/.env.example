# Copie este arquivo para ".env" e preencha com os seus dados.

# Porta do servidor
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=codify

# Chave secreta dos tokens de login. Use um texto longo e aleatório.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origem liberada para chamar a API (vazio = qualquer uma, bom para desenvolvimento)
CORS_ORIGIN=

# Pasta do front-end, relativa à pasta backend
FRONTEND_DIR=../frontend

# Executar código C dos alunos com o gcc do servidor.
# PERIGOSO em produção: ligue (true) só para testes locais.
EXECUTAR_CODIGO=false
