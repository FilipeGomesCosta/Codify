{
  "name": "codify-backend",
  "version": "1.0.0",
  "description": "API do Codify (Node.js + Express + MySQL)",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:reset": "node database/init.js && node database/seed.js",
    "db:init": "node database/init.js",
    "db:seed": "node database/seed.js",
    "db:migrate": "node database/migrar.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6"
  }
}
